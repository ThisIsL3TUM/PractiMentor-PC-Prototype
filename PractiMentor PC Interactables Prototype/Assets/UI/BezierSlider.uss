.bezier-slider {
	width: 180px;
	height: 180px;
	min-height: 180px;
	flex-grow: 0;
	position: absolute;
}

.bezier-slider .unity-base-slider__tracker{
	opacity: 0;
}

.bezier-slider .unity-base-slider__dragger{
	opacity: 0;
}

.bezier-slider #bezier-curve {
	position: absolute;
	left : 0;
	right : 0;
	top : 0;
	bottom : 0;
}